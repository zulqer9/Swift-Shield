      "enterprise": {
        "minLength": 14,
        "maxLength": 256,
        "requireUppercase": true,
        "requireLowercase": true,
        "requireNumbers": true,
        "requireSpecialChars": true,
        "forbiddenPatterns": ["123456", "password", "qwerty", "admin"],
        "minEntropy": 60
      }
    }
  },
  "features": {
    "clipboardIntegration": true,
    "passwordHistory": false,
    "strengthAnalysis": true,
    "securityHandbook": true,
    "exportOptions": ["text", "json"]
