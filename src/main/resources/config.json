  "security": {
    "passwordPolicies": {
      "default": {
        "minLength": 12,
        "maxLength": 128,
        "requireUppercase": true,
        "requireLowercase": true,
        "requireNumbers": true,
        "requireSpecialChars": true,
        "forbiddenPatterns": ["123456", "password", "qwerty"],
